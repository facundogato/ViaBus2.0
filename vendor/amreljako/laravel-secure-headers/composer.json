{
    "name": "amreljako/laravel-secure-headers",
    "description": "Laravel package to add essential HTTP Security Headers.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Amr Eljako",
            "email": "amreljako@example.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "illuminate/support": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Amreljako\\SecureHeaders\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Amreljako\\SecureHeaders\\SecureHeadersServiceProvider"
            ]
        }
    }
}
